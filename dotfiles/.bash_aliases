alias c='clear'
alias gc='git commit -m'
alias ga="git add"
alias gap='git add -p'
alias gs='git status'
alias gss='git status -sb'
alias gp='git push'
alias gpr='git pull --rebase'
alias gb='git branch'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate'
alias reload='source ~/.bashrc'